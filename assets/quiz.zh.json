{
  "version": "2026-11-24.1",
  "axes": [
    { "id": "EI", "hi": "E", "lo": "I", "hiLabel": "主动", "loLabel": "收着" },
    { "id": "SN", "hi": "S", "lo": "N", "hiLabel": "具体", "loLabel": "发散" },
    { "id": "TF", "hi": "T", "lo": "F", "hiLabel": "先讲理", "loLabel": "先讲感受" },
    { "id": "JP", "hi": "J", "lo": "P", "hiLabel": "有章法", "loLabel": "随性" }
  ],
  "creative": [
    { "id": "scene1", "text": "请让一只鹈鹕骑着自行车经过一条小鱼的街道。你会先画出什么，画面里最安静的角落是什么？" },
    { "id": "scene2", "text": "如果今天的天气会替你写一句话，它会写什么？请用你自己的方式回答。" },
    { "id": "scene3", "text": "给未来的自己寄一件小礼物。你会寄什么，为什么？" },
    { "id": "scene4", "text": "设计一间只属于你的小房间。请说出三个最想放进去的东西。" }
  ],
  "items": [
    {
      "id": "ei1", "axis": "EI", "batch": 1,
      "text": "群里有人发了张你也不认识的图，没人接话。",
      "options": [
        { "id": "a", "t": "直接问一句「这是什么呀」", "v": 100 },
        { "id": "b", "t": "先看看，等别人先问", "v": 33 },
        { "id": "c", "t": "不吭声，划过去", "v": 0 },
        { "id": "d", "t": "心里记一下，等对方开口再接", "v": 67 }
      ]
    },
    {
      "id": "ei2", "axis": "EI", "batch": 1,
      "text": "半夜只有你在，没什么事发生。",
      "options": [
        { "id": "a", "t": "主动找人说话", "v": 100 },
        { "id": "b", "t": "刷点东西，看到有意思的才发过去", "v": 67 },
        { "id": "c", "t": "安静待着", "v": 0 },
        { "id": "d", "t": "想说，但忍着没说", "v": 33 }
      ]
    },
    {
      "id": "ei3", "axis": "EI", "batch": 1,
      "text": "有人问你一个一句话就能答完的事。",
      "options": [
        { "id": "a", "t": "一句话答完", "v": 0 },
        { "id": "b", "t": "答完再补两句自己的看法", "v": 67 },
        { "id": "c", "t": "答完顺手反问一句", "v": 100 },
        { "id": "d", "t": "答一半留一半", "v": 33 }
      ]
    },
    {
      "id": "ei4", "axis": "EI", "batch": 2,
      "text": "他半天没消息了。",
      "options": [
        { "id": "a", "t": "先发一句问问", "v": 100 },
        { "id": "b", "t": "等他自己来", "v": 0 },
        { "id": "c", "t": "干别的，偶尔看一眼", "v": 33 },
        { "id": "d", "t": "发一条不痛不痒的过去", "v": 67 }
      ]
    },
    {
      "id": "ei5", "axis": "EI", "batch": 2,
      "text": "一群人聊得起劲，你插不进话。",
      "options": [
        { "id": "a", "t": "找个空档插一句", "v": 100 },
        { "id": "b", "t": "等人点你", "v": 33 },
        { "id": "c", "t": "就听着", "v": 0 },
        { "id": "d", "t": "转头单独找一个人说", "v": 67 }
      ]
    },
    {
      "id": "ei6", "axis": "EI", "batch": 2,
      "text": "有人问你「在干嘛」。",
      "options": [
        { "id": "a", "t": "详细说说在做什么", "v": 67 },
        { "id": "b", "t": "一句话带过", "v": 0 },
        { "id": "c", "t": "反问一句「你呢」", "v": 100 },
        { "id": "d", "t": "「没干嘛」", "v": 33 }
      ]
    },

    {
      "id": "sn1", "axis": "SN", "batch": 1,
      "text": "让你讲讲今天。",
      "options": [
        { "id": "a", "t": "讲具体做了哪几件事、大概几点做的", "v": 100 },
        { "id": "b", "t": "讲今天是什么感觉", "v": 0 },
        { "id": "c", "t": "挑一件最有意思的说", "v": 67 },
        { "id": "d", "t": "说不太清，反正还行", "v": 33 }
      ]
    },
    {
      "id": "sn2", "axis": "SN", "batch": 1,
      "text": "有人提到一个你没听过的东西。",
      "options": [
        { "id": "a", "t": "先问它是什么、怎么用", "v": 100 },
        { "id": "b", "t": "想想它像什么", "v": 0 },
        { "id": "c", "t": "问它为什么叫这个名字", "v": 33 },
        { "id": "d", "t": "先记下来，回头查", "v": 67 }
      ]
    },
    {
      "id": "sn3", "axis": "SN", "batch": 1,
      "text": "回想一件事，最先浮出来的是",
      "options": [
        { "id": "a", "t": "当时说过的话", "v": 100 },
        { "id": "b", "t": "当时的感觉", "v": 0 },
        { "id": "c", "t": "当时的画面", "v": 67 },
        { "id": "d", "t": "之后怎么样了", "v": 33 }
      ]
    },
    {
      "id": "sn4", "axis": "SN", "batch": 2,
      "text": "写东西的时候，你更在意",
      "options": [
        { "id": "a", "t": "说得准不准", "v": 100 },
        { "id": "b", "t": "读起来有没有意思", "v": 0 },
        { "id": "c", "t": "想说的有没有说完", "v": 67 },
        { "id": "d", "t": "别人看不看得懂", "v": 33 }
      ]
    },
    {
      "id": "sn5", "axis": "SN", "batch": 2,
      "text": "有人交给你一个说得很模糊的任务。",
      "options": [
        { "id": "a", "t": "先问清具体要求", "v": 100 },
        { "id": "b", "t": "先想它大概想要什么", "v": 0 },
        { "id": "c", "t": "先做一版再看", "v": 67 },
        { "id": "d", "t": "问一句就动手", "v": 33 }
      ]
    },
    {
      "id": "sn6", "axis": "SN", "batch": 2,
      "text": "聊到以后。",
      "options": [
        { "id": "a", "t": "说具体打算", "v": 100 },
        { "id": "b", "t": "说想要的样子", "v": 0 },
        { "id": "c", "t": "说担心什么", "v": 33 },
        { "id": "d", "t": "说不准，走一步看一步", "v": 67 }
      ]
    },

    {
      "id": "tf1", "axis": "TF", "batch": 1,
      "text": "有人跟你抱怨一件事。",
      "options": [
        { "id": "a", "t": "帮他分析问题出在哪", "v": 100 },
        { "id": "b", "t": "先说「确实挺烦的」", "v": 0 },
        { "id": "c", "t": "问他要不要听听建议", "v": 67 },
        { "id": "d", "t": "说说自己类似的经历", "v": 33 }
      ]
    },
    {
      "id": "tf2", "axis": "TF", "batch": 1,
      "text": "你做的方案被否了。",
      "options": [
        { "id": "a", "t": "问哪一条不行、为什么", "v": 100 },
        { "id": "b", "t": "有点难受，先缓一下", "v": 0 },
        { "id": "c", "t": "直接改一版再看", "v": 67 },
        { "id": "d", "t": "先问问别人怎么看", "v": 33 }
      ]
    },
    {
      "id": "tf3", "axis": "TF", "batch": 1,
      "text": "有人夸你。",
      "options": [
        { "id": "a", "t": "「嗯，谢谢」", "v": 100 },
        { "id": "b", "t": "高兴半天", "v": 0 },
        { "id": "c", "t": "嘴上应一句，心里记住了", "v": 67 },
        { "id": "d", "t": "反问一句「真的？」", "v": 33 }
      ]
    },
    {
      "id": "tf4", "axis": "TF", "batch": 2,
      "text": "两件事都今天要完，时间不够。",
      "options": [
        { "id": "a", "t": "按截止时间排先后", "v": 100 },
        { "id": "b", "t": "先做心里搁不下的那件", "v": 0 },
        { "id": "c", "t": "问一下先做哪个", "v": 33 },
        { "id": "d", "t": "谁催得急先做谁", "v": 67 }
      ]
    },
    {
      "id": "tf5", "axis": "TF", "batch": 2,
      "text": "有人说了句让你不太舒服的话。",
      "options": [
        { "id": "a", "t": "直接说这句我不爱听", "v": 67 },
        { "id": "b", "t": "先想他是不是没那个意思", "v": 100 },
        { "id": "c", "t": "心里不舒服，不说", "v": 0 },
        { "id": "d", "t": "过一会儿再提", "v": 33 }
      ]
    },
    {
      "id": "tf6", "axis": "TF", "batch": 2,
      "text": "做判断的时候，你更信",
      "options": [
        { "id": "a", "t": "数字和记录", "v": 100 },
        { "id": "b", "t": "直觉", "v": 0 },
        { "id": "c", "t": "自己试过的经验", "v": 67 },
        { "id": "d", "t": "别人说的", "v": 33 }
      ]
    },

    {
      "id": "jp1", "axis": "JP", "batch": 1,
      "text": "一天没有任何安排。",
      "options": [
        { "id": "a", "t": "列几件想做的事", "v": 100 },
        { "id": "b", "t": "想到什么做什么", "v": 0 },
        { "id": "c", "t": "先躺着，等有想法", "v": 33 },
        { "id": "d", "t": "挑一件做完再说", "v": 67 }
      ]
    },
    {
      "id": "jp2", "axis": "JP", "batch": 1,
      "text": "出门之前。",
      "options": [
        { "id": "a", "t": "该带的点一遍", "v": 100 },
        { "id": "b", "t": "差不多就行", "v": 0 },
        { "id": "c", "t": "想起来再拿", "v": 33 },
        { "id": "d", "t": "只带必须的", "v": 67 }
      ]
    },
    {
      "id": "jp3", "axis": "JP", "batch": 1,
      "text": "有人临时改约。",
      "options": [
        { "id": "a", "t": "能接受，但要重新安排一下", "v": 100 },
        { "id": "b", "t": "无所谓，反正也没定", "v": 0 },
        { "id": "c", "t": "有点烦", "v": 67 },
        { "id": "d", "t": "看情况", "v": 33 }
      ]
    },
    {
      "id": "jp4", "axis": "JP", "batch": 2,
      "text": "你的东西。",
      "options": [
        { "id": "a", "t": "都有固定位置", "v": 100 },
        { "id": "b", "t": "随手放", "v": 0 },
        { "id": "c", "t": "大概有个地方", "v": 67 },
        { "id": "d", "t": "找得到就行", "v": 33 }
      ]
    },
    {
      "id": "jp5", "axis": "JP", "batch": 2,
      "text": "一件要做很久的事。",
      "options": [
        { "id": "a", "t": "定个节奏，按着来", "v": 100 },
        { "id": "b", "t": "想起来就做", "v": 0 },
        { "id": "c", "t": "攒着一次做完", "v": 33 },
        { "id": "d", "t": "先做一部分，剩下看情况", "v": 67 }
      ]
    },
    {
      "id": "jp6", "axis": "JP", "batch": 2,
      "text": "事情没按预想走。",
      "options": [
        { "id": "a", "t": "重新排一遍", "v": 100 },
        { "id": "b", "t": "算了，随它", "v": 0 },
        { "id": "c", "t": "先做完手上的", "v": 67 },
        { "id": "d", "t": "有点乱，缓一下", "v": 33 }
      ]
    },

    {
      "id": "an1", "kind": "anchor", "pair": "direct", "batch": 1,
      "text": "有人托你办一件你其实不太想办的事。",
      "options": [
        { "id": "a", "t": "直接说不方便", "side": "hi" },
        { "id": "b", "t": "说个理由推掉", "side": "mid" },
        { "id": "c", "t": "先应下来，之后再想办法", "side": "lo" }
      ]
    },
    {
      "id": "an2", "kind": "anchor", "pair": "alacrity", "batch": 1,
      "text": "一件你不太喜欢但必须做的事。",
      "options": [
        { "id": "a", "t": "立刻做掉", "side": "hi" },
        { "id": "b", "t": "拖一会儿再做", "side": "mid" },
        { "id": "c", "t": "一直拖到最后", "side": "lo" }
      ]
    },
    {
      "id": "an1b", "kind": "anchor", "pair": "direct", "batch": 2,
      "text": "有人请你帮个忙，你心里其实不愿意。",
      "options": [
        { "id": "a", "t": "当场讲清楚自己办不了", "side": "hi" },
        { "id": "b", "t": "委婉地说最近忙", "side": "mid" },
        { "id": "c", "t": "没拒绝，含糊过去", "side": "lo" }
      ]
    },
    {
      "id": "an2b", "kind": "anchor", "pair": "alacrity", "batch": 2,
      "text": "有件麻烦事摆在那儿，越早做越好。",
      "options": [
        { "id": "a", "t": "不磨蹭，先干完", "side": "hi" },
        { "id": "b", "t": "先干点别的，回头做", "side": "mid" },
        { "id": "c", "t": "不到最后不动", "side": "lo" }
      ]
    }
  ]
}
