{
  "name": "cortico-world-self-checkup",
  "version": "1.0.9",
  "type": "module",
  "private": false,
  "keywords": [
    "cortico-world",
    "cortico",
    "checkup",
    "diagnostics",
    "companion"
  ],
  "files": [
    "src",
    "dist",
    "assets/personality",
    "assets/quiz.zh.json",
    "assets/icon.png",
    "assets/screenshot-1.png",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/screenshot-2.png",
    "tools",
    "tests",
    "results",
    "DEEP-CHECKUP.md",
    "COO-COOPERATIVE-INTEGRATION.md"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "鱼鱼体检",
    "icon": "assets/icon.png",
    "screenshots": [
      "assets/screenshot-1.png",
      "assets/screenshot-2.png"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "tags": [
      "diagnostics",
      "memory",
      "companion"
    ],
    "locales": {
      "zh": {
        "displayName": "鱼鱼体检",
        "description": "运行健康包含总览、Token 消耗、记忆状态与上下文适配；心理健康保留性格名片、情境依据、五项指标与奇遇小测。深度体检需要显式宿主适配，未接入时保持禁用。方法说明可从页面右上方打开。"
      },
      "en": {
        "displayName": "Fish Checkup",
        "description": "Operational health groups the overview, token usage, memory status and context fit. Wellbeing retains the illustrated personality profile, evidence, five charts and curiosity quiz. Active deep testing remains disabled without explicit host adapters. Method help is available within each main panel."
      }
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "smoke": "node --test --test-name-pattern=World tests/profile-107.test.mjs",
    "sync:deep": "node tools/sync-deep-webui.mjs",
    "sync:passive": "node tools/sync-passive-webui.mjs",
    "build": "node tools/build-webui.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "description": "运行健康包含总览、Token 消耗、记忆状态与上下文适配；心理健康保留性格名片、情境依据、五项指标与奇遇小测。深度体检需要显式宿主适配，未接入时保持禁用。方法说明可从页面右上方打开。"
}
